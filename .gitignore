# Python
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.py[cod]
*.egg-info/
venv/
.venv/

# Model weights (downloaded at runtime from HuggingFace)
backend/model_cache/
*.pt
*.pth
*.bin
*.safetensors

# Environment secrets
# Note: `backend/.env` is intentionally allowed to be committed per user request
# (private repo). If the repo ever goes public, remove it and rotate HF_TOKEN.
.env
.env.local
.env.*.local
!.env.example
!backend/.env

# Temp / uploads
backend/tmp/
backend/uploads/
*.tmp

# Generated reports (created at runtime)
backend/generated_reports
backend/generated_reports/*.json
backend/generated_reports/*.pdf
backend/generated_reports/*.pem
backend/generated_complaints/*.json
backend/generated_complaints/*.pdf
backend/generated_complaints/*.pem
backend/generated_complaints/

# Private keys anywhere (Ed25519 report-signing key must never be committed)
*.pem
*.key

# Audio uploads saved by the backend
backend/audio/uploads/

# Benchmark / evaluation output
benchmarks/
# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude Code
.claude/

# Planning docs (not for repo)
IMPLEMENTATION_PLAN.md
manipulation_workflow.md

# Logs
*.log

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Stray lockfile from running npm at the repo root (the app lives in frontend/)
/package-lock.json
